name "security-crypto"
description "Spring Security's spring-security-crypto for Flint: password encoders"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:java" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-security" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
